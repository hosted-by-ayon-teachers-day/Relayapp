<?xml version="1.0" encoding="utf-8"?>
<!--
    Vertical stack: native top bar -> thin progress line -> WebView (fills the rest) -> native bottom nav.
    MainActivity pads this root by the system-bar/keyboard insets; its obsidian background
    is what shows behind the status and navigation bars.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/relay_obsidian"
    android:orientation="vertical">

    <!-- Top bar: centered "RELAY" wordmark + gear on the right -->
    <FrameLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/relay_obsidian">

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:letterSpacing="0.25"
            android:text="@string/toolbar_title"
            android:textColor="@color/relay_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings"
            app:tint="@color/relay_white" />
    </FrameLayout>

    <!-- Page-load progress, doubles as the hairline under the top bar -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:visibility="invisible"
        app:indicatorColor="@color/relay_white"
        app:trackColor="@color/relay_hairline"
        app:trackThickness="2dp" />

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom navigation: wrapped so the hairline hides together with it when the keyboard opens -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/relay_hairline" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/relay_obsidian"
            app:elevation="0dp"
            app:itemIconTint="@color/nav_item_tint"
            app:itemTextColor="@color/nav_item_tint"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>
</LinearLayout>
